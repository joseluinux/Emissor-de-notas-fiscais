<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            Migrations sao geradas pelo dotnet ef e nunca editadas a mao (ver CLAUDE.md).
            Medi-las so dilui o numero: sao ~500 linhas que nenhum teste deve exercitar.
            Program continua contado de proposito — o 0% ali e honesto, e a composition
            root, que so um teste de integracao cobriria.
          -->
          <Exclude>[*]*.Migrations.*</Exclude>
          <!--
            Sem ExcludeByAttribute aqui. CompilerGeneratedAttribute parece inofensivo mas
            remove as state machines de todo metodo async, que e onde mora a logica destes
            dois servicos — com ele ligado o MovimentacaoEstoqueService "sobe" para 50%
            porque metade do metodo deixa de ser medida.
          -->

        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
